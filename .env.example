# ===== T0 認證環境變數（設定於 Vercel → Project Settings → Environment Variables）=====

# 32+ 字元隨機密鑰。產生方式：openssl rand -base64 32
AUTH_SECRET=

# 白名單（逗號分隔）。Banson、吳嘉倩、Patty、Bella、許舒婷 的 Email，由 Banson 提供。
ALLOWED_EMAILS=banson@example.com,gm@example.com

# resend.com 免費方案 API key（每月 3,000 封，遠超需求）
RESEND_API_KEY=

# 寄件位址。未驗證自有網域前可用 onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# 正式網址（magic link 的 base URL）
APP_URL=https://pure-dashboard-mu.vercel.app
